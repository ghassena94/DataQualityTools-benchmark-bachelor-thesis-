# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# NOTE: must stay anchored, exactly like /datasets/ below. The unanchored
# "utils/" matched at every depth and silently excluded dBoost's
# cleaners/dBoost/dboost/utils/ package, which is why it was never committed
# and why dboost/metadata_driven could never import.
/utils/

# folders
cleaners/CleanML/
cleaners/activeclean
RAHA/

# NOTE: must stay anchored with a leading slash. An unanchored "datasets/"
# matches at every depth and silently excluded ED2's Python package
# cleaners/ed2/model/ml/datasets/, which is why it was never committed.
/datasets/

cleaners/openrefine-3.4.1/
cleaners/raha/supplementaries/
utils/adults
cleaners/katara/knowledge-base
strategy-profiling/
raha-baran-results-adult
reports

datasets/airbnb/actual_errors.csv
datasets/airbnb/data_augmentation_experiment/
datasets/airbnb/raha-baran-results-airbnb/
datasets/airbnb/results/
datasets/beers/actual_errors.csv
datasets/beers/data_description.csv
datasets/beers/raha-baran-results-beers/
datasets/beers/results/

datasets/flights/clean_original.csv
datasets/flights/data_description.csv
datasets/flights/dirty_original.csv
datasets/flights/results

MANIFEST.in
input/
test_beers.py
backup/

# Run artifacts dropped in the working directory by vendored libraries whose output
# path is not configurable: DataWig (used by CPClean's imputers) writes model
# checkpoints to ./index/, and Picket saves its text embeddings to ./vec.npy and
# ./vocab.npy because embed_config[TEXT]['path'] is commented out.
/index/
/vec.npy
/vocab.npy
